{
  "name": "kaneo-books",
  "version": "0.1.1",
  "description": "Import book metadata into Kaneo from ISBNs and ASINs",
  "type": "module",
  "bin": {
    "kaneo-books": "./src/cli.ts"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/cli.ts --compile --outfile dist/kaneo-books",
    "check": "bun run typecheck && bun test"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "cheerio": "^1.1.2",
    "commander": "^14.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  }
}
